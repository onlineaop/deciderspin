# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and never committed.

# Site origin used to build absolute canonical/Open Graph URLs. Defaults to
# http://localhost:3000 if unset; set the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 measurement ID, carried over from the WordPress site's Site Kit
# integration to preserve tracking continuity.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1LBD4WJVWE

# SMTP credentials for the contact form (lib/mail.ts), sent via the
# admin@deciderspin.com mailbox. Hostinger bundles email hosting with the
# domain — find these under hPanel -> Emails -> Connect Apps & Devices ->
# Manual configuration (Outgoing/SMTP server). Typical Hostinger values:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@deciderspin.com
SMTP_PASSWORD=replace-with-the-real-mailbox-password

# Where contact form submissions are delivered. Defaults to SMTP_USER's
# mailbox if unset.
CONTACT_TO_EMAIL=admin@deciderspin.com
